<template>
	<view class="page" v-if="data">
		<view class="status-bar">
			<text class="status" :class="getStatusClass(data.status)">{{ data.status }}</text>
		</view>
		<view class="section">
			<text class="section-title">服务信息</text>
			<view class="row"><text class="lbl">服务类型:</text><text class="val">{{ data.serviceName }}</text></view>
			<view class="row"><text class="lbl">地点:</text><text class="val">{{ data.location }}</text></view>
			<view class="row"><text class="lbl">描述:</text><text class="val">{{ data.description }}</text></view>
			<view class="row"><text class="lbl">联系方式:</text><text class="val">{{ data.contact }}</text></view>
		</view>
		<view class="section">
			<text class="section-title">其他信息</text>
			<view class="row"><text class="lbl">提交时间:</text><text class="val">{{ data.createTime }}</text></view>
		</view>
		<view v-if="data.status === '待处理'" class="btn-area">
			<view class="cancel-btn" @click="doCancel"><text class="cancel-text">取消预约</text></view>
		</view>
	</view>
	<view v-else class="page"><view class="empty"><text class="empty-text">加载中...</text></view></view>
</template>

<script setup>
	import { ref } from 'vue';
	import { request } from '@/utils/api.uts';

	const data = ref(null);

	onLoad((options) => {
		if (options && options.id) {
			request({ url: '/reservation/detail?id=' + options.id }).then((res) => {
				if (res && res.code === 200) { data.value = res.data; }
			});
		}
	});

	const doCancel = () => {
		uni.showModal({ title: '提示', content: '确定要取消吗？', success: (res) => {
			if (res.confirm && data.value) {
				request({ url: '/reservation/cancel', method: 'POST', data: { id: data.value.id } }).then((res2) => {
					if (res2 && res2.code === 200) { uni.showToast({ title: '取消成功', icon: 'success' }); setTimeout(() => { uni.navigateBack(); }, 800); }
				});
			}
		}});
	};

	const getStatusClass = (status) => {
		const map = { '待处理': 'pending', '处理中': 'processing', '已完成': 'completed', '已取消': 'cancelled' };
		return map[status] || '';
	};
</script>

<style>
	.page { min-height: 100vh; background-color: #f5f5f5; }
	.status-bar { background-color: #ffffff; padding: 40rpx; align-items: center; }
	.status { font-size: 32rpx; padding: 10rpx 30rpx; border-radius: 40rpx; }
	.status.pending { background-color: #fff7e6; color: #fa8c16; }
	.status.processing { background-color: #e6f7ff; color: #1890ff; }
	.status.completed { background-color: #f6ffed; color: #52c41a; }
	.status.cancelled { background-color: #f5f5f5; color: #999999; }
	.section { background-color: #ffffff; margin-top: 20rpx; padding: 30rpx; }
	.section-title { font-size: 32rpx; font-weight: bold; color: #333333; margin-bottom: 24rpx; }
	.row { flex-direction: row; margin-bottom: 16rpx; }
	.lbl { font-size: 28rpx; color: #999999; margin-right: 16rpx; }
	.val { font-size: 28rpx; color: #333333; }
	.btn-area { padding: 40rpx; }
	.cancel-btn { height: 88rpx; border-width: 1px; border-color: #ff4d4f; border-radius: 44rpx; align-items: center; justify-content: center; }
	.cancel-text { font-size: 32rpx; color: #ff4d4f; }
	.empty { padding-top: 300rpx; align-items: center; }
	.empty-text { font-size: 28rpx; color: #999999; }
</style>
