<template>
	<view class="page">
		<view class="field">
			<text class="label">服务类型</text>
			<text class="value">{{ sname }}</text>
		</view>
		<view class="field">
			<text class="label">地点</text>
			<input class="input" type="text" v-model="form.location" placeholder="请输入地点" />
		</view>
		<view class="field">
			<text class="label">{{ type === 'repair' ? '问题描述' : '预约说明' }}</text>
			<textarea class="textarea" v-model="form.description" placeholder="请描述具体情况" />
		</view>
		<view class="field">
			<text class="label">联系方式</text>
			<input class="input" type="text" v-model="form.contact" placeholder="请输入手机号" />
		</view>
		<view class="btn" @click="doSubmit"><text class="btn-text">提交预约</text></view>
	</view>
</template>

<script setup>
	import { ref, computed } from 'vue';
	import { request, getUserInfo } from '@/utils/api.uts';

	const type = ref('');
	const map = { selfroom: '自习室预约', repair: '宿舍报修', errands: '跑腿代取' };
	const sname = computed(() => map[type.value] || '');
	const form = ref({ location: '', description: '', contact: '' });

	onLoad((options) => {
		if (options && options.type) { type.value = options.type; }
	});

	const doSubmit = async () => {
		if (!form.value.location) { uni.showToast({ title: '请输入地点', icon: 'none' }); return; }
		if (!form.value.description || form.value.description.length < 10) { uni.showToast({ title: '描述不少于10个字', icon: 'none' }); return; }
		if (!form.value.contact) { uni.showToast({ title: '请输入联系方式', icon: 'none' }); return; }

		const info = getUserInfo();
		if (!info) { uni.navigateTo({ url: '/pages/login/login' }); return; }

		try {
			const res = await request({
				url: '/reservation/create', method: 'POST',
				data: { serviceType: type.value, serviceName: sname.value, location: form.value.location, description: form.value.description, contact: form.value.contact, userId: info.id }
			});
			if (res && res.code === 200) {
				uni.showToast({ title: '提交成功', icon: 'success' });
				setTimeout(() => { uni.navigateTo({ url: '/pages/service/my' }); }, 800);
			}
		} catch (e) {}
	};
</script>

<style>
	.page { min-height: 100vh; background-color: #f5f5f5; padding: 30rpx; }
	.field { margin-bottom: 36rpx; }
	.label { font-size: 28rpx; color: #333333; margin-bottom: 16rpx; }
	.value { height: 88rpx; border-width: 1px; border-color: #dddddd; border-radius: 16rpx; padding-left: 30rpx; justify-content: center; font-size: 30rpx; color: #333333; background-color: #f5f5f5; }
	.input { height: 88rpx; border-width: 1px; border-color: #dddddd; border-radius: 16rpx; padding-left: 30rpx; padding-right: 30rpx; font-size: 30rpx; background-color: #ffffff; }
	.textarea { height: 200rpx; border-width: 1px; border-color: #dddddd; border-radius: 16rpx; padding: 20rpx 30rpx; font-size: 30rpx; background-color: #ffffff; width: 100%; }
	.btn { height: 96rpx; background-color: #007AFF; border-radius: 48rpx; align-items: center; justify-content: center; margin-top: 60rpx; }
	.btn-text { font-size: 32rpx; color: #ffffff; }
</style>
