<template>
	<view class="page" v-if="notice">
		<text class="title">{{ notice.title }}</text>
		<view class="meta">
			<text class="tag">{{ notice.category }}</text>
			<text class="time">{{ notice.publishTime }}</text>
			<text class="pub">{{ notice.publisher }}</text>
		</view>
		<text class="body">{{ notice.content }}</text>
	</view>
	<view v-else class="page">
		<view class="empty"><text class="empty-text">加载中...</text></view>
	</view>
</template>

<script setup>
	import { ref } from 'vue';
	import { request } from '@/utils/api.uts';

	const notice = ref(null);

	onLoad((options) => {
		if (options && options.id) {
			request({ url: '/notice/detail?id=' + options.id }).then((res) => {
				if (res && res.code === 200) { notice.value = res.data; }
			});
		}
	});
</script>

<style>
	.page { min-height: 100vh; background-color: #ffffff; padding: 40rpx; }
	.title { font-size: 40rpx; font-weight: bold; color: #333333; margin-bottom: 30rpx; }
	.meta { flex-direction: row; align-items: center; padding-bottom: 30rpx; border-bottom-width: 1px; border-bottom-color: #f0f0f0; margin-bottom: 40rpx; }
	.tag { font-size: 24rpx; color: #007AFF; background-color: #e6f7ff; padding-top: 4rpx; padding-bottom: 4rpx; padding-left: 16rpx; padding-right: 16rpx; border-radius: 8rpx; margin-right: 20rpx; }
	.time { font-size: 24rpx; color: #999999; margin-right: 20rpx; }
	.pub { font-size: 24rpx; color: #999999; }
	.body { font-size: 30rpx; color: #333333; line-height: 1.8; }
	.empty { padding-top: 300rpx; align-items: center; }
	.empty-text { font-size: 28rpx; color: #999999; }
</style>
