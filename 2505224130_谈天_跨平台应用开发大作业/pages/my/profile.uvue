<template>
	<view class="page">
		<view class="user-box" @click="goEdit">
			<image class="avatar-img" :src="userInfo && userInfo.avatar ? userInfo.avatar : '/static/logo.png'"></image>
			<view class="user-info">
				<text class="user-name">{{ (userInfo && userInfo.nickname) ? userInfo.nickname : '未设置昵称' }}</text>
				<text class="user-account">{{ (userInfo && userInfo.username) ? userInfo.username : '' }}</text>
			</view>
			<text class="arrow">></text>
		</view>

		<view class="menu-group">
			<view class="menu-item" @click="goMyProducts">
				<text class="menu-text">我的发布</text>
				<text class="arrow">></text>
			</view>
			<view class="menu-item" @click="goMyReservations">
				<text class="menu-text">我的预约</text>
				<text class="arrow">></text>
			</view>
			<view class="menu-item" @click="goMessages">
				<text class="menu-text">消息中心</text>
				<text class="arrow">></text>
			</view>
		</view>

		<view class="menu-group">
			<view class="menu-item" @click="goEdit">
				<text class="menu-text">个人资料</text>
				<text class="arrow">></text>
			</view>
		</view>

		<view class="logout-btn" @click="doLogout">
			<text class="logout-text">退出登录</text>
		</view>
	</view>
</template>

<script setup>
	import { ref } from 'vue';
	import { getUserInfo, clearUserInfo } from '@/utils/api.uts';

	const userInfo = ref(null);

	onShow(() => {
		const info = getUserInfo();
		userInfo.value = info;
	});

	const goEdit = () => { uni.navigateTo({ url: '/pages/my/edit' }); };
	const goMyProducts = () => { uni.navigateTo({ url: '/pages/product/my' }); };
	const goMyReservations = () => { uni.navigateTo({ url: '/pages/service/my' }); };
	const goMessages = () => { uni.navigateTo({ url: '/pages/message/list' }); };

	const doLogout = () => {
		uni.showModal({
			title: '提示',
			content: '确定要退出登录吗？',
			success: (res) => {
				if (res.confirm) {
					clearUserInfo();
					uni.reLaunch({ url: '/pages/login/login' });
				}
			}
		});
	};
</script>

<style>
	.page {
		min-height: 100vh;
		background-color: #f5f5f5;
	}

	.user-box {
		background-color: #ffffff;
		padding-top: 60rpx;
		padding-bottom: 60rpx;
		padding-left: 40rpx;
		padding-right: 40rpx;
		flex-direction: row;
		align-items: center;
	}

	.avatar-img {
		width: 120rpx;
		height: 120rpx;
		border-radius: 60rpx;
	}

	.user-info {
		flex: 1;
		margin-left: 30rpx;
	}

	.user-name {
		font-size: 36rpx;
		font-weight: bold;
		color: #333333;
	}

	.user-account {
		font-size: 28rpx;
		color: #999999;
		margin-top: 10rpx;
	}

	.arrow {
		font-size: 32rpx;
		color: #999999;
	}

	.menu-group {
		background-color: #ffffff;
		margin-top: 20rpx;
	}

	.menu-item {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-top: 30rpx;
		padding-bottom: 30rpx;
		padding-left: 40rpx;
		padding-right: 40rpx;
		border-bottom-width: 1px;
		border-bottom-color: #f5f5f5;
	}

	.menu-text {
		font-size: 30rpx;
		color: #333333;
	}

	.logout-btn {
		background-color: #ffffff;
		margin-top: 40rpx;
		padding-top: 30rpx;
		padding-bottom: 30rpx;
		align-items: center;
	}

	.logout-text {
		font-size: 30rpx;
		color: #ff4d4f;
	}
</style>
