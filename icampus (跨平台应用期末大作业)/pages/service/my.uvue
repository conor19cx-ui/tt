<template>
	<view class="page">
		<view class="tabs">
			<view class="tab" :class="{ active: cur === '' }" @click="change('')"><text class="tab-text">全部</text></view>
			<view class="tab" :class="{ active: cur === '待处理' }" @click="change('待处理')"><text class="tab-text">待处理</text></view>
			<view class="tab" :class="{ active: cur === '处理中' }" @click="change('处理中')"><text class="tab-text">处理中</text></view>
			<view class="tab" :class="{ active: cur === '已完成' }" @click="change('已完成')"><text class="tab-text">已完成</text></view>
		</view>
		<view class="list">
			<view class="item" v-for="item in list" :key="item.id" @click="goDetail(item.id)">
				<view class="head">
					<text class="name">{{ item.serviceName }}</text>
					<text class="status" :class="getStatusClass(item.status)">{{ item.status }}</text>
				</view>
				<text class="info">地点: {{ item.location }}</text>
				<text class="info">提交时间: {{ formatTime(item.createTime) }}</text>
			</view>
			<view v-if="list.length === 0" class="empty"><text class="empty-text">你还没有提交任何预约</text></view>
		</view>
	</view>
</template>

<script setup>
	import { ref } from 'vue';
	import { request, getUserInfo } from '@/utils/api.uts';

	const list = ref([]);
	const cur = ref('');

	const formatTime = (time) => {
		if (!time) return '';
		const str = String(time);
		const match = str.match(/(\d{4})-(\d{1,2})-(\d{1,2})/);
		if (match) {
			return parseInt(match[2]) + '月' + parseInt(match[3]) + '日';
		}
		return '';
	};

	const loadData = () => {
		const info = getUserInfo();
		if (!info) return;
		request({ url: '/reservation/my?page=1&size=20&userId=' + info.id + '&status=' + cur.value }).then((res) => {
			if (res && res.code === 200) { list.value = res.data || []; }
		});
	};

	const change = (s) => { cur.value = s === '全部' ? '' : s; loadData(); };
	const goDetail = (id) => { uni.navigateTo({ url: '/pages/service/detail?id=' + id }); };

	const getStatusClass = (status) => {
		const map = { '待处理': 'pending', '处理中': 'processing', '已完成': 'completed', '已取消': 'cancelled' };
		return map[status] || '';
	};

	loadData();
</script>

<style>
	.page { min-height: 100vh; background-color: #f5f5f5; }
	.tabs { background-color: #ffffff; flex-direction: row; padding: 20rpx 30rpx; }
	.tab { padding: 12rpx 24rpx; border-radius: 30rpx; margin-right: 15rpx; }
	.tab.active { background-color: #007AFF; }
	.tab-text { font-size: 24rpx; color: #666666; }
	.tab.active .tab-text { color: #ffffff; }
	.list { padding: 20rpx; }
	.item { background-color: #ffffff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
	.head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
	.name { font-size: 32rpx; font-weight: bold; color: #333333; }
	.status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
	.status.pending { background-color: #fff7e6; color: #fa8c16; }
	.status.processing { background-color: #e6f7ff; color: #1890ff; }
	.status.completed { background-color: #f6ffed; color: #52c41a; }
	.status.cancelled { background-color: #f5f5f5; color: #999999; }
	.info { font-size: 26rpx; color: #666666; margin-bottom: 8rpx; }
	.empty { padding-top: 200rpx; align-items: center; }
	.empty-text { font-size: 28rpx; color: #999999; }
</style>
